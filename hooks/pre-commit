#!/bin/sh
# Pre-commit hook: sincroniza EXAMPLE_DB en index.html desde el CSV.
# Se ejecuta automáticamente antes de cada `git commit`.

REPO_ROOT="$(git rev-parse --show-toplevel)"
BUILD="$REPO_ROOT/build.py"
CSV="$REPO_ROOT/prompt_injection_ejemplos.csv"
HTML="$REPO_ROOT/index.html"

# Detectar un Python que realmente funcione (descarta el alias falso de Microsoft Store)
PYTHON=""
for candidate in python3 python py; do
  if $candidate -c "import sys; sys.exit(0)" 2>/dev/null; then
    PYTHON=$candidate
    break
  fi
done

if [ -z "$PYTHON" ]; then
  echo "[build] ERROR: Python no encontrado o no funciona."
  echo "        Instalalo desde https://python.org (marcá 'Add to PATH' al instalar)."
  echo "        En Windows, deshabilitá el alias de Microsoft Store en:"
  echo "        Configuración > Aplicaciones > Alias de ejecución de aplicaciones > python.exe"
  exit 1
fi

# Solo correr si el CSV está en el staging area
if git diff --cached --name-only | grep -q "prompt_injection_ejemplos\.csv"; then
  echo "[build] Sincronizando EXAMPLE_DB…"
  "$PYTHON" "$BUILD"
  if [ $? -ne 0 ]; then
    echo "[build] ERROR: build.py falló. Commit cancelado."
    exit 1
  fi
  git add "$HTML"
  echo "[build] index.html actualizado y agregado al commit."
fi
